node_modules/

# Secrets / credentials — never commit
# Every .env variant (ROADMAP SEC-11): `.env.production` and friends matched none of
# the old three lines. An example file, if one is ever added, is the one exception.
.env*
!.env.example

# Runtime configuration. Holds SMTP + LDAP credentials and the Telegram bot token.
# Volume-mounted in production (see docker-compose.yaml); seed a new install from
# settings.example.json.
settings.json

# Runtime state (volume-mounted / regenerated at run time)
gametracker.db
gametracker.db-journal
gametracker.db-wal
gametracker.db-shm
sent_notifications.json
crackwatch-cache.json
system-status-cache.json
