<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.GameTracker" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/gt_accent</item>
        <item name="colorPrimaryDark">@color/gt_accent_dim</item>
        <item name="android:windowBackground">@color/gt_surface_1</item>
        <item name="colorAccent">@color/gt_accent</item>
        <item name="android:colorBackground">@color/gt_surface_1</item>
        <item name="android:textColor">@color/gt_text_primary</item>
        <item name="colorSurface">@color/gt_surface_2</item>
        <item name="colorSurfaceVariant">@color/gt_surface_3</item>
        <item name="colorOnSurface">@color/gt_text_primary</item>
        <item name="colorOnSurfaceVariant">@color/gt_text_secondary</item>
        <item name="colorOnPrimary">#0C0D11</item>
        <!-- MOB-31: drawn edge-to-edge (EdgeToEdge.kt); the bars show the screen beneath. -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <!-- Chip styling -->
        <item name="chipStyle">@style/Widget.Material3.Chip.Filter</item>
    </style>

    <!-- Default filter chip style -->
    <style name="GameTrackerChip" parent="Widget.Material3.Chip.Filter">
        <item name="chipBackgroundColor">@color/gt_surface_3</item>
        <item name="chipStrokeColor">@color/gt_border_strong</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="android:textColor">@color/gt_text_secondary</item>
        <item name="chipCornerRadius">20dp</item>
    </style>

    <!-- Selected chip style -->
    <style name="GameTrackerChip.Selected" parent="GameTrackerChip">
        <item name="chipBackgroundColor">@color/gt_accent_dim</item>
        <item name="android:textColor">?attr/colorPrimary</item>
        <item name="chipStrokeColor">?attr/colorPrimary</item>
    </style>

    <!-- ── Accent colour theme overlays ─────────────────────────────────────── -->
    <!-- parent="" intentionally: each overlay only overrides what it declares.  -->
    <!-- Apply with: theme.applyStyle(ThemeManager.getThemeResId(this), true)    -->
    <!-- called in Activity.onCreate() BEFORE setContentView().                  -->

    <!-- MOB-33: the web's six presets (frontend/src/App.jsx ACCENT_PRESETS), Violet the
         default. colorOnPrimary is the higher-contrast of white and #0C0D11 for each; dark
         wins on all six (Violet 4.59:1, the lowest). test/runtime.test.js computes it. -->
    <style name="ThemeOverlay.GameTracker.Violet" parent="">
        <item name="colorPrimary">#8B5CF6</item>
        <item name="colorPrimaryDark">#7C3AED</item>
        <item name="colorAccent">#8B5CF6</item>
        <item name="colorOnPrimary">#0C0D11</item>
    </style>

    <style name="ThemeOverlay.GameTracker.Blue" parent="">
        <item name="colorPrimary">#3B82F6</item>
        <item name="colorPrimaryDark">#2563EB</item>
        <item name="colorAccent">#3B82F6</item>
        <item name="colorOnPrimary">#0C0D11</item>
    </style>

    <style name="ThemeOverlay.GameTracker.Emerald" parent="">
        <item name="colorPrimary">#10B981</item>
        <item name="colorPrimaryDark">#059669</item>
        <item name="colorAccent">#10B981</item>
        <item name="colorOnPrimary">#0C0D11</item>
    </style>

    <style name="ThemeOverlay.GameTracker.Amber" parent="">
        <item name="colorPrimary">#F59E0B</item>
        <item name="colorPrimaryDark">#D97706</item>
        <item name="colorAccent">#F59E0B</item>
        <item name="colorOnPrimary">#0C0D11</item>
    </style>

    <style name="ThemeOverlay.GameTracker.Rose" parent="">
        <item name="colorPrimary">#F43F5E</item>
        <item name="colorPrimaryDark">#E11D48</item>
        <item name="colorAccent">#F43F5E</item>
        <item name="colorOnPrimary">#0C0D11</item>
    </style>

    <style name="ThemeOverlay.GameTracker.Cyan" parent="">
        <item name="colorPrimary">#06B6D4</item>
        <item name="colorPrimaryDark">#0891B2</item>
        <item name="colorAccent">#06B6D4</item>
        <item name="colorOnPrimary">#0C0D11</item>
    </style>

</resources>
