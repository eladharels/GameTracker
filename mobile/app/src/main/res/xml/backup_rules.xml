<?xml version="1.0" encoding="utf-8"?>
<!-- Android 11 and older (Auto Backup). The session token lives in the "auth" preferences and
     must never leave the device in a backup (MOB-4). Everything else (theme, accent, notes)
     is still backed up. -->
<full-backup-content>
    <exclude domain="sharedpref" path="auth.xml" />
</full-backup-content>
