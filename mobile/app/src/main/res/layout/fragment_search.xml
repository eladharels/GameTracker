<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/gt_surface_0">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="22dp"
        android:paddingTop="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textStyle="bold"
            android:text="Discover"
            android:textSize="26sp"
            android:textColor="@color/gt_text_primary"
            tools:ignore="HardcodedText" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="Search across IGDB, Steam &amp; RAWG"
            android:textSize="14sp"
            android:textColor="@color/gt_text_secondary"
            tools:ignore="HardcodedText" />

        <!-- Search bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/input_field_bg"
            android:layout_marginTop="16dp"
            android:paddingStart="16dp"
            android:paddingEnd="8dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_search"
                android:tint="?attr/colorPrimary"
                android:layout_marginEnd="11dp"
                android:contentDescription="Search" />

            <EditText
                android:id="@+id/etSearch"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:hint="Game title, series, genre…"
                android:textColor="@color/gt_text_primary"
                android:textColorHint="@color/gt_text_muted"
                android:background="@android:color/transparent"
                android:inputType="text"
                android:imeOptions="actionSearch"
                android:maxLines="1"
                android:textSize="15sp"
                tools:ignore="HardcodedText" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSearch"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:minWidth="0dp"
                android:text="Search"
                android:textColor="?attr/colorPrimary"
                android:textStyle="bold"
                android:textSize="13sp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                tools:ignore="HardcodedText" />
        </LinearLayout>
    </LinearLayout>

    <!-- Trending / recent searches -->
    <TextView
        android:id="@+id/tvRecentLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:layout_marginStart="22dp"
        android:layout_marginBottom="2dp"
        android:visibility="gone"
        android:text="Recent searches"
        android:textSize="11sp"
        android:textStyle="bold"
        android:textAllCaps="true"
        android:letterSpacing="0.1"
        android:textColor="@color/gt_text_muted"
        tools:ignore="HardcodedText" />

    <HorizontalScrollView
        android:id="@+id/searchHistoryScroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:paddingStart="22dp"
        android:paddingEnd="22dp"
        android:paddingTop="8dp"
        android:paddingBottom="6dp"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/searchHistoryChipContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />
    </HorizontalScrollView>

    <!-- Welcome / empty state -->
    <LinearLayout
        android:id="@+id/welcomeMessage"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="32dp">

        <ImageView
            android:layout_width="76dp"
            android:layout_height="76dp"
            android:src="@drawable/ic_gamepad"
            android:tint="?attr/colorPrimary"
            android:alpha="0.45"
            android:layout_marginBottom="22dp"
            android:contentDescription="Search illustration" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textStyle="bold"
            android:text="Find your next obsession"
            android:textAlignment="center"
            android:textColor="@color/gt_text_primary"
            android:textSize="18sp"
            android:layout_marginBottom="8dp"
            tools:ignore="HardcodedText" />

        <TextView
            android:layout_width="240dp"
            android:layout_height="wrap_content"
            android:text="Type a title, series, or genre to search across every source."
            android:textAlignment="center"
            android:textColor="@color/gt_text_secondary"
            android:textSize="14sp"
            android:lineSpacingMultiplier="1.5"
            tools:ignore="HardcodedText" />
    </LinearLayout>

    <!-- Results label -->
    <TextView
        android:id="@+id/tvSearchResultsHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Results"
        android:textSize="11sp"
        android:textStyle="bold"
        android:textColor="@color/gt_text_muted"
        android:textAllCaps="true"
        android:letterSpacing="0.1"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="6dp"
        android:layout_marginStart="22dp"
        android:visibility="gone"
        tools:ignore="HardcodedText" />

    <!-- Results list -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:scrollbars="none"
        android:paddingBottom="16dp" />

    <!-- No results state -->
    <LinearLayout
        android:id="@+id/errorState"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="32dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textStyle="bold"
            android:text="No matches"
            android:textAlignment="center"
            android:textColor="@color/gt_text_primary"
            android:textSize="17sp"
            android:layout_marginBottom="8dp"
            tools:ignore="HardcodedText" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Try a different title, series, or genre keyword."
            android:textAlignment="center"
            android:textColor="@color/gt_text_secondary"
            android:textSize="14sp"
            tools:ignore="HardcodedText" />
    </LinearLayout>
</LinearLayout>
