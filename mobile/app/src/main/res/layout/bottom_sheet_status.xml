<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bottom_sheet_surface_bg"
    android:paddingBottom="32dp">

    <!-- Drag handle pill -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/status_badge_bg"
        android:backgroundTint="@color/gt_text_muted" />

    <!-- Sheet title + game name -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Change Status"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@color/gt_text_primary"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:layout_marginBottom="4dp" />

    <TextView
        android:id="@+id/tvSheetGameName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="16dp"
        android:text="Game Name"
        android:textSize="13sp"
        android:textColor="@color/gt_text_secondary"
        android:maxLines="1"
        android:ellipsize="end" />

    <!-- CTA block: Playing → Mark as Done (shown only for Playing games) -->
    <LinearLayout
        android:id="@+id/ctaMarkDone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="4dp"
        android:paddingBottom="12dp"
        android:visibility="gone">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCtaMarkDone"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="🎉  Mark as Done"
            android:textAllCaps="false"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@android:color/white"
            android:backgroundTint="@color/gt_status_done"
            app:cornerRadius="14dp" />

    </LinearLayout>

    <!-- CTA block: Unreleased → Add Release Reminder (shown only for Unreleased games) -->
    <LinearLayout
        android:id="@+id/ctaReleaseReminder"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="4dp"
        android:paddingBottom="12dp"
        android:visibility="gone">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCtaReleaseReminder"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="Add Release Reminder"
            android:textAllCaps="false"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@android:color/white"
            android:backgroundTint="@color/gt_status_unreleased"
            app:cornerRadius="14dp"
            app:icon="@drawable/ic_calendar"
            app:iconTint="@android:color/white"
            app:iconSize="18dp"
            app:iconGravity="textStart" />

    </LinearLayout>

    <!-- Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/gt_border"
        android:layout_marginBottom="4dp" />

    <!-- Wishlist -->
    <LinearLayout
        android:id="@+id/itemWishlist"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true">

        <View
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:background="@drawable/status_badge_bg"
            android:backgroundTint="@color/gt_status_wishlist"
            android:layout_marginEnd="18dp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Wishlist"
            android:textSize="15sp"
            android:textColor="@color/gt_text_primary" />

        <View
            android:layout_width="6dp"
            android:layout_height="6dp"
            android:background="@drawable/status_badge_bg"
            android:backgroundTint="@color/gt_status_wishlist"
            android:alpha="0.4" />

    </LinearLayout>

    <!-- Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/gt_border"
        android:layout_marginStart="20dp" />

    <!-- Playing -->
    <LinearLayout
        android:id="@+id/itemPlaying"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true">

        <View
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:background="@drawable/status_badge_bg"
            android:backgroundTint="@color/gt_status_playing"
            android:layout_marginEnd="18dp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Playing"
            android:textSize="15sp"
            android:textColor="@color/gt_text_primary" />

        <View
            android:layout_width="6dp"
            android:layout_height="6dp"
            android:background="@drawable/status_badge_bg"
            android:backgroundTint="@color/gt_status_playing"
            android:alpha="0.4" />

    </LinearLayout>

    <!-- Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/gt_border"
        android:layout_marginStart="20dp" />

    <!-- Done -->
    <LinearLayout
        android:id="@+id/itemDone"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true">

        <View
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:background="@drawable/status_badge_bg"
            android:backgroundTint="@color/gt_status_done"
            android:layout_marginEnd="18dp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Done"
            android:textSize="15sp"
            android:textColor="@color/gt_text_primary" />

        <View
            android:layout_width="6dp"
            android:layout_height="6dp"
            android:background="@drawable/status_badge_bg"
            android:backgroundTint="@color/gt_status_done"
            android:alpha="0.4" />

    </LinearLayout>

    <!-- Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/gt_border"
        android:layout_marginStart="20dp" />

    <!-- Backlog -->
    <LinearLayout
        android:id="@+id/itemBacklog"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true">

        <View
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:background="@drawable/status_badge_bg"
            android:backgroundTint="@color/gt_status_backlog"
            android:layout_marginEnd="18dp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Backlog"
            android:textSize="15sp"
            android:textColor="@color/gt_text_primary" />

        <View
            android:layout_width="6dp"
            android:layout_height="6dp"
            android:background="@drawable/status_badge_bg"
            android:backgroundTint="@color/gt_status_backlog"
            android:alpha="0.4" />

    </LinearLayout>

    <!-- Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/gt_border"
        android:layout_marginStart="20dp" />

    <!-- Unreleased -->
    <LinearLayout
        android:id="@+id/itemUnreleased"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true">

        <View
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:background="@drawable/status_badge_bg"
            android:backgroundTint="@color/gt_status_unreleased"
            android:layout_marginEnd="18dp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Unreleased"
            android:textSize="15sp"
            android:textColor="@color/gt_text_primary" />

        <View
            android:layout_width="6dp"
            android:layout_height="6dp"
            android:background="@drawable/status_badge_bg"
            android:backgroundTint="@color/gt_status_unreleased"
            android:alpha="0.4" />

    </LinearLayout>

</LinearLayout>
