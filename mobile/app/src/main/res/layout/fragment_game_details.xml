<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/gt_surface_0"
    android:scrollbars="none"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Hero cover -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="300dp">

            <ImageView
                android:id="@+id/ivGameCover"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:background="@drawable/cover_gradient"
                android:contentDescription="Game cover" />

            <View
                android:layout_width="match_parent"
                android:layout_height="160dp"
                android:layout_gravity="bottom"
                android:background="@drawable/cover_fade_overlay" />

            <FrameLayout
                android:id="@+id/btnBack"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginTop="14dp"
                android:layout_marginStart="16dp"
                android:background="@drawable/detail_close_bg"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_chevron_left"
                    android:contentDescription="Back" />
            </FrameLayout>
        </FrameLayout>

        <!-- Content -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="-50dp"
            android:paddingHorizontal="22dp"
            android:paddingBottom="36dp">

            <TextView
                android:id="@+id/tvGameTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textStyle="bold"
                android:text="Game Title"
                android:textSize="26sp"
                android:textColor="@color/gt_text_primary"
                android:lineSpacingMultiplier="1.1"
                tools:ignore="HardcodedText" />

            <!-- Meta row -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="10dp">

                <TextView
                    android:id="@+id/tvReleaseDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="@color/gt_text_secondary"
                    tools:text="2022 · Action RPG" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="  ·  "
                    android:textSize="13sp"
                    android:textColor="@color/gt_text_muted"
                    tools:ignore="HardcodedText" />

                <TextView
                    android:id="@+id/tvPrice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="@color/gt_status_done"
                    tools:text="$59.99" />
            </LinearLayout>

            <!-- Status -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/card_surface_20"
                android:padding="18dp"
                android:layout_marginTop="22dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="STATUS"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="@color/gt_text_muted"
                    android:letterSpacing="0.1"
                    android:layout_marginBottom="12dp"
                    tools:ignore="HardcodedText" />

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/chipGroupStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:singleSelection="true"
                    app:chipSpacingHorizontal="8dp" />
            </LinearLayout>

            <!-- Rating + hours -->
            <LinearLayout
                android:id="@+id/cardRating"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/card_surface_20"
                android:padding="18dp"
                android:layout_marginTop="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="14dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="YOUR RATING · THIS DEVICE"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="@color/gt_text_muted"
                        android:letterSpacing="0.1"
                        tools:ignore="HardcodedText" />

                    <TextView
                        android:id="@+id/tvHoursPlayed"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="@color/gt_text_secondary"
                        tools:text="Not synced" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/starContainer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />
            </LinearLayout>

            <!-- Personal notes -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/card_surface_20"
                android:padding="18dp"
                android:layout_marginTop="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="PERSONAL NOTES · THIS DEVICE"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="@color/gt_text_muted"
                    android:letterSpacing="0.1"
                    android:layout_marginBottom="12dp"
                    tools:ignore="HardcodedText" />

                <EditText
                    android:id="@+id/etGameNotes"
                    android:layout_width="match_parent"
                    android:layout_height="92dp"
                    android:background="@drawable/input_field_bg_13"
                    android:inputType="textMultiLine"
                    android:gravity="top|start"
                    android:hint="What did you think? Add a note…"
                    android:textColor="@color/gt_text_primary"
                    android:textColorHint="@color/gt_text_muted"
                    android:textSize="13.5sp"
                    android:padding="12dp"
                    android:lineSpacingMultiplier="1.4"
                    tools:ignore="HardcodedText" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="12dp">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSaveNote"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:text="Save Note"
                        android:textAllCaps="false"
                        android:textSize="13sp"
                        app:cornerRadius="12dp"
                        android:layout_marginEnd="8dp"
                        tools:ignore="HardcodedText" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnRefreshMetadata"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="44dp"
                        android:text="Refresh"
                        android:textAllCaps="false"
                        android:textColor="@color/gt_text_light"
                        android:textSize="13sp"
                        app:cornerRadius="12dp"
                        app:strokeColor="@color/gt_border_strong"
                        app:icon="@drawable/ic_refresh"
                        app:iconTint="?attr/colorPrimary"
                        app:iconSize="16dp"
                        tools:ignore="HardcodedText" />
                </LinearLayout>
            </LinearLayout>

            <!-- Remove -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRemoveFromLibrary"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="18dp"
                android:text="Remove from library"
                android:textAllCaps="false"
                android:textStyle="bold"
                android:textSize="15sp"
                android:backgroundTint="#0FFF4D4F"
                android:textColor="@color/gt_logout_red"
                app:strokeColor="#66FF4D4F"
                app:strokeWidth="1dp"
                app:cornerRadius="15dp"
                tools:ignore="HardcodedText" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
