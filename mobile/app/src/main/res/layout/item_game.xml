<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:layout_marginStart="22dp"
    android:layout_marginEnd="22dp"
    android:layout_marginTop="5dp"
    android:layout_marginBottom="6dp"
    android:background="@drawable/card_surface"
    android:clipToOutline="true"
    android:padding="12dp">

    <!-- Status accent bar (left edge) -->
    <View
        android:id="@+id/viewStatusBorder"
        android:layout_width="4dp"
        android:layout_height="64dp"
        android:layout_marginEnd="8dp"
        android:background="@color/gt_status_wishlist" />

    <!-- Cover image -->
    <FrameLayout
        android:layout_width="60dp"
        android:layout_height="80dp"
        android:layout_marginEnd="14dp">

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp">

            <ImageView
                android:id="@+id/ivCover"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:background="@drawable/game_cover_bg"
                android:contentDescription="Game cover" />
        </androidx.cardview.widget.CardView>

        <!-- Backlog position badge (top-left corner of image) -->
        <TextView
            android:id="@+id/tvBacklogPosition"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:layout_margin="4dp"
            android:background="@drawable/status_badge_bg"
            android:backgroundTint="@color/gt_status_backlog"
            android:textColor="@color/white"
            android:textSize="9sp"
            android:textStyle="bold"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:visibility="gone" />
    </FrameLayout>

    <!-- Game info -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginEnd="8dp">

        <TextView
            android:id="@+id/tvName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@color/gt_text_primary"
            android:maxLines="2"
            android:ellipsize="end"
            android:lineSpacingMultiplier="1.1" />

        <TextView
            android:id="@+id/tvReleaseDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="12.5sp"
            android:textColor="@color/gt_text_secondary"
            android:layout_marginTop="4dp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="9dp">

            <!-- Status chip -->
            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="10sp"
                android:textColor="@color/white"
                android:textStyle="bold"
                android:textAllCaps="true"
                android:letterSpacing="0.05"
                android:background="@drawable/status_badge_bg"
                android:paddingStart="9dp"
                android:paddingEnd="9dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:visibility="gone" />

            <!-- Price chip -->
            <TextView
                android:id="@+id/tvPrice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="12.5sp"
                android:textStyle="bold"
                android:textColor="@color/gt_status_done"
                android:layout_marginStart="8dp"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>

    <!-- Actions -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center">

        <ImageView
            android:id="@+id/ivDragHandle"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:src="@drawable/ic_drag_handle"
            android:tint="@color/gt_text_muted"
            android:contentDescription="Drag to reorder"
            android:visibility="gone"
            android:padding="10dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAdd"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="+"
            android:textSize="22sp"
            android:visibility="gone"
            android:backgroundTint="?attr/colorPrimary"
            android:textColor="?attr/colorOnPrimary"
            app:cornerRadius="13dp"
            android:paddingStart="0dp"
            android:paddingEnd="0dp" />

        <ImageButton
            android:id="@+id/btnDelete"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_delete"
            android:contentDescription="@string/delete"
            android:visibility="gone"
            android:tint="@color/gt_logout_red"
            android:padding="12dp" />
    </LinearLayout>
</LinearLayout>
